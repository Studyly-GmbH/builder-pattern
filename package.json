{
  "name": "builder-pattern",
  "repository": "https://github.com/Vincent-Pang/builder-pattern.git",
  "version": "2.2.0",
  "license": "MIT",
  "scripts": {
    "build": "tsup ./src/index.ts --format esm",
    "buildWithDts": "tsup ./src/index.ts --format esm --dts --sourcemap",
    "test": "jest",
    "lint": "eslint -c .eslintrc.js --ext .ts src/**/*.ts __tests__/**/*.ts",
    "prepublishOnly": "rimraf dist && npm run buildWithDts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "jest": {
    "preset": "ts-jest/presets/default",
    "collectCoverage": true,
    "coverageDirectory": "test_coverage_dir",
    "collectCoverageFrom": [
      "src/**/*.ts"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^60.6.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "jest": "^30.2.0",
    "prettier": "3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.4",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}

